<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - <%= config.title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #0f1117;
            color: #fff;
            min-height: 100vh;
        }

        .admin-container {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 260px;
            background: #161922;
            padding: 24px;
            border-right: 1px solid rgba(255,255,255,0.1);
        }

        .sidebar-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 32px;
            color: #667eea;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 16px;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-bottom: 8px;
            color: rgba(255,255,255,0.7);
        }

        .nav-item:hover, .nav-item.active {
            background: rgba(102, 126, 234, 0.15);
            color: #667eea;
        }

        .nav-item i {
            width: 20px;
        }

        /* Main Content */
        .main-content {
            flex: 1;
            padding: 32px;
            overflow-y: auto;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 32px;
        }

        .header h1 {
            font-size: 2rem;
            font-weight: 700;
        }

        .header-actions {
            display: flex;
            gap: 12px;
        }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .btn-danger {
            background: rgba(244, 67, 54, 0.2);
            color: #f44336;
            border: 1px solid rgba(244, 67, 54, 0.3);
        }

        .btn-danger:hover {
            background: rgba(244, 67, 54, 0.3);
        }

        .btn-success {
            background: rgba(76, 175, 80, 0.2);
            color: #4caf50;
            border: 1px solid rgba(76, 175, 80, 0.3);
        }

        .btn-success:hover {
            background: rgba(76, 175, 80, 0.3);
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            margin-bottom: 32px;
        }

        .stat-card {
            background: rgba(255,255,255,0.05);
            border-radius: 20px;
            padding: 24px;
            border: 1px solid rgba(255,255,255,0.1);
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            margin-bottom: 16px;
        }

        .stat-icon.blue { background: rgba(102, 126, 234, 0.2); color: #667eea; }
        .stat-icon.green { background: rgba(76, 175, 80, 0.2); color: #4caf50; }
        .stat-icon.orange { background: rgba(255, 152, 0, 0.2); color: #ff9800; }
        .stat-icon.red { background: rgba(244, 67, 54, 0.2); color: #f44336; }

        .stat-value {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .stat-label {
            color: rgba(255,255,255,0.6);
            font-size: 0.9rem;
        }

        /* Tables */
        .table-container {
            background: rgba(255,255,255,0.05);
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.1);
            overflow: hidden;
        }

        .table-header {
            padding: 20px 24px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .table-title {
            font-size: 1.2rem;
            font-weight: 600;
        }

        .table-search {
            padding: 10px 16px;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 10px;
            color: #fff;
            width: 250px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 16px 24px;
            text-align: left;
        }

        th {
            background: rgba(255,255,255,0.03);
            font-weight: 600;
            color: rgba(255,255,255,0.6);
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        td {
            border-top: 1px solid rgba(255,255,255,0.05);
        }

        tr:hover td {
            background: rgba(255,255,255,0.03);
        }

        .ip-address {
            font-family: monospace;
            background: rgba(102, 126, 234, 0.15);
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 0.85rem;
        }

        .badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .badge.success {
            background: rgba(76, 175, 80, 0.2);
            color: #4caf50;
        }

        .badge.danger {
            background: rgba(244, 67, 54, 0.2);
            color: #f44336;
        }

        .badge.warning {
            background: rgba(255, 152, 0, 0.2);
            color: #ff9800;
        }

        .action-btn {
            padding: 8px 16px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.85rem;
            transition: all 0.3s ease;
            margin-right: 8px;
        }

        .action-btn.ban {
            background: rgba(244, 67, 54, 0.2);
            color: #f44336;
        }

        .action-btn.ban:hover {
            background: rgba(244, 67, 54, 0.3);
        }

        .action-btn.unban {
            background: rgba(76, 175, 80, 0.2);
            color: #4caf50;
        }

        .action-btn.unban:hover {
            background: rgba(76, 175, 80, 0.3);
        }

        /* Tabs */
        .tabs {
            display: flex;
            gap: 8px;
            margin-bottom: 24px;
        }

        .tab {
            padding: 12px 24px;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            color: rgba(255,255,255,0.7);
        }

        .tab:hover, .tab.active {
            background: rgba(102, 126, 234, 0.2);
            border-color: #667eea;
            color: #667eea;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        /* Loading */
        .loading {
            text-align: center;
            padding: 40px;
            color: rgba(255,255,255,0.5);
        }

        .loading i {
            font-size: 2rem;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        /* Toast */
        .toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            padding: 16px 24px;
            background: rgba(76, 175, 80, 0.2);
            border: 1px solid rgba(76, 175, 80, 0.3);
            border-radius: 12px;
            color: #4caf50;
            font-weight: 500;
            transform: translateY(100px);
            opacity: 0;
            transition: all 0.3s ease;
        }

        .toast.show {
            transform: translateY(0);
            opacity: 1;
        }

        .toast.error {
            background: rgba(244, 67, 54, 0.2);
            border-color: rgba(244, 67, 54, 0.3);
            color: #f44336;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .admin-container {
                flex-direction: column;
            }

            .sidebar {
                width: 100%;
                padding: 16px;
            }

            .main-content {
                padding: 16px;
            }

            .stats-grid {
                grid-template-columns: 1fr 1fr;
            }

            .table-container {
                overflow-x: auto;
            }

            table {
                min-width: 600px;
            }
        }
    </style>
</head>
<body>
    <div class="admin-container">
        <!-- Sidebar -->
        <div class="sidebar">
            <div class="sidebar-title">
                <i class="fas fa-shield-alt"></i> Admin Panel
            </div>
            <div class="nav-item active" onclick="showTab('banned')">
                <i class="fas fa-ban"></i>
                <span>Banned IPs</span>
            </div>
            <div class="nav-item" onclick="showTab('social')">
                <i class="fas fa-share-alt"></i>
                <span>Social Media</span>
            </div>
            <div class="nav-item" onclick="showTab('links')">
                <i class="fas fa-link"></i>
                <span>Link Sections</span>
            </div>
            <div class="nav-item" onclick="logout()">
                <i class="fas fa-sign-out-alt"></i>
                <span>Logout</span>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Banned IPs Tab -->
            <div id="banned" class="tab-content active">
                <div class="header">
                    <h1>Banned IPs</h1>
                </div>

                <div class="table-container">
                    <div class="table-header">
                        <div class="table-title">Blocked IPs</div>
                        <input type="text" class="table-search" placeholder="Ban IP..." id="banInput" onkeypress="handleBanKeypress(event)">
                        <button class="btn btn-danger" onclick="banCustomIP()" style="margin-left: 8px;">
                            <i class="fas fa-plus"></i> Ban IP
                        </button>
                    </div>
                    <table>
                        <thead>
                            <tr>
                                <th>IP Address</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="bannedTable">
                            <tr>
                                <td colspan="3" class="loading">
                                    <i class="fas fa-spinner"></i><br>Loading...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Social Media Tab -->
            <div id="social" class="tab-content">
                <div class="header">
                    <h1>Social Media Links</h1>
                    <div class="header-actions">
                        <button class="btn btn-primary" onclick="saveSocialMedia()">
                            <i class="fas fa-save"></i> Save Changes
                        </button>
                    </div>
                </div>

                <div class="table-container" style="padding: 24px;">
                    <div id="socialMediaContainer">
                        <div class="loading">
                            <i class="fas fa-spinner"></i><br>Loading social media...
                        </div>
                    </div>
                </div>
            </div>

            <!-- Link Sections Tab -->
            <div id="links" class="tab-content">
                <div class="header">
                    <h1>Link Sections</h1>
                    <div class="header-actions">
                        <button class="btn btn-primary" onclick="saveLinkSections()">
                            <i class="fas fa-save"></i> Save Changes
                        </button>
                    </div>
                </div>

                <div class="table-container" style="padding: 24px;">
                    <div id="linkSectionsContainer">
                        <div class="loading">
                            <i class="fas fa-spinner"></i><br>Loading link sections...
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div class="toast" id="toast"></div>

    <script>
        // Tab switching
        function showTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
            
            document.getElementById(tabId).classList.add('active');
            event.currentTarget.classList.add('active');
        }

        // Load banned IPs
        async function loadBanned() {
            try {
                const response = await fetch('/admin/banned');
                const banned = await response.json();
                
                const tbody = document.getElementById('bannedTable');
                if (banned.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="3" style="text-align: center; color: rgba(255,255,255,0.5);">No banned IPs</td></tr>';
                    return;
                }
                
                tbody.innerHTML = banned.map(ip => `
                    <tr>
                        <td><span class="ip-address">${ip}</span></td>
                        <td><span class="badge danger">Blocked</span></td>
                        <td>
                            <button class="action-btn unban" onclick="unbanIP('${ip}')">
                                <i class="fas fa-check"></i> Unban
                            </button>
                        </td>
                    </tr>
                `).join('');
            } catch (error) {
                document.getElementById('bannedTable').innerHTML = '<tr><td colspan="3" style="text-align: center; color: #f44336;">Failed to load banned IPs</td></tr>';
            }
        }

        // Ban custom IP
        async function banCustomIP() {
            const ip = document.getElementById('banInput').value.trim();
            if (!ip) {
                showToast('Please enter an IP address', true);
                return;
            }
            
            if (!confirm(`Ban IP ${ip}?`)) return;
            
            try {
                const response = await fetch(`/admin/ban?ip=${encodeURIComponent(ip)}`, {
                    method: 'POST'
                });
                const data = await response.json();
                
                if (data.success) {
                    showToast(data.message);
                    document.getElementById('banInput').value = '';
                    loadBanned();
                } else {
                    showToast(data.error || 'Failed to ban IP', true);
                }
            } catch (error) {
                showToast('Failed to ban IP', true);
            }
        }

        // Handle enter key for ban input
        function handleBanKeypress(event) {
            if (event.key === 'Enter') {
                banCustomIP();
            }
        }

        // Unban IP
        async function unbanIP(ip) {
            if (!confirm(`Unban IP ${ip}?`)) return;
            
            try {
                const response = await fetch(`/admin/unban?ip=${encodeURIComponent(ip)}`, {
                    method: 'POST'
                });
                const data = await response.json();
                
                if (data.success) {
                    showToast(data.message);
                    loadBanned();
                } else {
                    showToast(data.error || 'Failed to unban IP', true);
                }
            } catch (error) {
                showToast('Failed to unban IP', true);
            }
        }

        // Load social media
        async function loadSocialMedia() {
            try {
                const response = await fetch('/admin/social-media');
                const socialMedia = await response.json();
                
                const container = document.getElementById('socialMediaContainer');
                container.innerHTML = socialMedia.map((item, index) => `
                    <div class="social-item" style="margin-bottom: 24px; padding: 20px; background: rgba(255,255,255,0.05); border-radius: 12px;">
                        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 16px; align-items: end;">
                            <div>
                                <label style="display: block; margin-bottom: 8px; color: rgba(255,255,255,0.7); font-size: 0.9rem;">Name</label>
                                <input type="text" class="table-search" style="width: 100%;" value="${item.name}" data-field="name" data-index="${index}">
                            </div>
                            <div>
                                <label style="display: block; margin-bottom: 8px; color: rgba(255,255,255,0.7); font-size: 0.9rem;">Icon</label>
                                <input type="text" class="table-search" style="width: 100%;" value="${item.icon}" data-field="icon" data-index="${index}">
                            </div>
                            <div>
                                <label style="display: block; margin-bottom: 8px; color: rgba(255,255,255,0.7); font-size: 0.9rem;">URL</label>
                                <input type="text" class="table-search" style="width: 100%;" value="${item.url}" data-field="url" data-index="${index}">
                            </div>
                            <button class="btn btn-danger" onclick="removeSocialItem(${index})" style="padding: 10px 16px;">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                        <div style="margin-top: 16px;">
                            <label style="display: block; margin-bottom: 8px; color: rgba(255,255,255,0.7); font-size: 0.9rem;">Color</label>
                            <input type="text" class="table-search" style="width: 200px;" value="${item.color}" data-field="color" data-index="${index}">
                        </div>
                    </div>
                `).join('') + `
                    <button class="btn btn-success" onclick="addSocialItem()" style="width: 100%; margin-top: 16px;">
                        <i class="fas fa-plus"></i> Add Social Media Link
                    </button>
                `;
            } catch (error) {
                document.getElementById('socialMediaContainer').innerHTML = '<div style="text-align: center; color: #f44336;">Failed to load social media</div>';
            }
        }

        // Save social media
        async function saveSocialMedia() {
            const items = [];
            document.querySelectorAll('#socialMediaContainer .social-item').forEach((item, index) => {
                const inputs = item.querySelectorAll('input');
                items.push({
                    name: inputs[0].value,
                    icon: inputs[1].value,
                    url: inputs[2].value,
                    color: inputs[3].value
                });
            });
            
            try {
                const response = await fetch('/admin/social-media', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(items)
                });
                const data = await response.json();
                
                if (data.success) {
                    showToast('Social media updated successfully');
                } else {
                    showToast('Failed to update social media', true);
                }
            } catch (error) {
                showToast('Failed to update social media', true);
            }
        }

        // Add social item
        function addSocialItem() {
            const container = document.getElementById('socialMediaContainer');
            const newItem = document.createElement('div');
            newItem.className = 'social-item';
            newItem.style.cssText = 'margin-bottom: 24px; padding: 20px; background: rgba(255,255,255,0.05); border-radius: 12px;';
            newItem.innerHTML = `
                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 16px; align-items: end;">
                    <div>
                        <label style="display: block; margin-bottom: 8px; color: rgba(255,255,255,0.7); font-size: 0.9rem;">Name</label>
                        <input type="text" class="table-search" style="width: 100%;" value="" data-field="name">
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 8px; color: rgba(255,255,255,0.7); font-size: 0.9rem;">Icon</label>
                        <input type="text" class="table-search" style="width: 100%;" value="" data-field="icon">
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 8px; color: rgba(255,255,255,0.7); font-size: 0.9rem;">URL</label>
                        <input type="text" class="table-search" style="width: 100%;" value="" data-field="url">
                    </div>
                    <button class="btn btn-danger" onclick="removeSocialItem(this.parentElement.parentElement)" style="padding: 10px 16px;">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
                <div style="margin-top: 16px;">
                    <label style="display: block; margin-bottom: 8px; color: rgba(255,255,255,0.7); font-size: 0.9rem;">Color</label>
                    <input type="text" class="table-search" style="width: 200px;" value="#667eea" data-field="color">
                </div>
            `;
            
            // Insert before the "Add" button
            const addButton = container.querySelector('.btn-success');
            container.insertBefore(newItem, addButton);
        }

        // Remove social item
        function removeSocialItem(indexOrElement) {
            if (typeof indexOrElement === 'number') {
                // Remove by index
                const items = document.querySelectorAll('#socialMediaContainer .social-item');
                if (items[indexOrElement]) {
                    items[indexOrElement].remove();
                }
            } else {
                // Remove by element
                indexOrElement.remove();
            }
        }

        // Load link sections
        async function loadLinkSections() {
            try {
                const response = await fetch('/admin/link-sections');
                const linkSections = await response.json();
                
                const container = document.getElementById('linkSectionsContainer');
                container.innerHTML = linkSections.map((section, sectionIndex) => `
                    <div class="section-item" style="margin-bottom: 32px; padding: 24px; background: rgba(255,255,255,0.05); border-radius: 12px;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; flex: 1;">
                                <div>
                                    <label style="display: block; margin-bottom: 8px; color: rgba(255,255,255,0.7); font-size: 0.9rem;">Section Title</label>
                                    <input type="text" class="table-search" style="width: 100%;" value="${section.title}" data-field="title" data-section="${sectionIndex}">
                                </div>
                                <div></div>
                            </div>
                            <button class="btn btn-danger" onclick="removeSection(${sectionIndex})" style="margin-left: 16px;">
                                <i class="fas fa-trash"></i> Remove Section
                            </button>
                        </div>
                        
                        <div class="links-container">
                            ${section.links.map((link, linkIndex) => `
                                <div class="link-item" style="margin-bottom: 16px; padding: 16px; background: rgba(255,255,255,0.03); border-radius: 8px;">
                                    <div style="display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 12px; align-items: end; margin-bottom: 12px;">
                                        <div>
                                            <label style="display: block; margin-bottom: 4px; color: rgba(255,255,255,0.6); font-size: 0.8rem;">Title</label>
                                            <input type="text" class="table-search" style="width: 100%;" value="${link.title}" data-field="title" data-section="${sectionIndex}" data-link="${linkIndex}">
                                        </div>
                                        <div>
                                            <label style="display: block; margin-bottom: 4px; color: rgba(255,255,255,0.6); font-size: 0.8rem;">Subtitle</label>
                                            <input type="text" class="table-search" style="width: 100%;" value="${link.subtitle}" data-field="subtitle" data-section="${sectionIndex}" data-link="${linkIndex}">
                                        </div>
                                        <div>
                                            <label style="display: block; margin-bottom: 4px; color: rgba(255,255,255,0.6); font-size: 0.8rem;">URL</label>
                                            <input type="text" class="table-search" style="width: 100%;" value="${link.url}" data-field="url" data-section="${sectionIndex}" data-link="${linkIndex}">
                                        </div>
                                        <button class="btn btn-danger" onclick="removeLink(${sectionIndex}, ${linkIndex})" style="padding: 8px 12px;">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; align-items: end;">
                                        <div>
                                            <label style="display: block; margin-bottom: 4px; color: rgba(255,255,255,0.6); font-size: 0.8rem;">Icon</label>
                                            <input type="text" class="table-search" style="width: 100%;" value="${link.icon}" data-field="icon" data-section="${sectionIndex}" data-link="${linkIndex}">
                                        </div>
                                        <div>
                                            <label style="display: block; margin-bottom: 4px; color: rgba(255,255,255,0.6); font-size: 0.8rem;">Color</label>
                                            <input type="text" class="table-search" style="width: 100%;" value="${link.color}" data-field="color" data-section="${sectionIndex}" data-link="${linkIndex}">
                                        </div>
                                    </div>
                                </div>
                            `).join('')}
                            
                            <button class="btn btn-success" onclick="addLink(${sectionIndex})" style="width: 100%; margin-top: 12px;">
                                <i class="fas fa-plus"></i> Add Link
                            </button>
                        </div>
                    </div>
                `).join('') + `
                    <button class="btn btn-primary" onclick="addSection()" style="width: 100%; margin-top: 24px;">
                        <i class="fas fa-plus"></i> Add Section
                    </button>
                `;
            } catch (error) {
                document.getElementById('linkSectionsContainer').innerHTML = '<div style="text-align: center; color: #f44336;">Failed to load link sections</div>';
            }
        }

        // Save link sections
        async function saveLinkSections() {
            const sections = [];
            document.querySelectorAll('#linkSectionsContainer .section-item').forEach((sectionEl, sectionIndex) => {
                const titleInput = sectionEl.querySelector('input[data-field="title"]');
                const links = [];
                
                sectionEl.querySelectorAll('.link-item').forEach((linkEl, linkIndex) => {
                    const inputs = linkEl.querySelectorAll('input');
                    links.push({
                        title: inputs[0].value,
                        subtitle: inputs[1].value,
                        url: inputs[2].value,
                        icon: inputs[3].value,
                        color: inputs[4].value
                    });
                });
                
                sections.push({
                    title: titleInput.value,
                    links: links
                });
            });
            
            try {
                const response = await fetch('/admin/link-sections', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(sections)
                });
                const data = await response.json();
                
                if (data.success) {
                    showToast('Link sections updated successfully');
                } else {
                    showToast('Failed to update link sections', true);
                }
            } catch (error) {
                showToast('Failed to update link sections', true);
            }
        }

        // Add section
        function addSection() {
            const container = document.getElementById('linkSectionsContainer');
            const newSection = document.createElement('div');
            newSection.className = 'section-item';
            newSection.style.cssText = 'margin-bottom: 32px; padding: 24px; background: rgba(255,255,255,0.05); border-radius: 12px;';
            newSection.innerHTML = `
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; flex: 1;">
                        <div>
                            <label style="display: block; margin-bottom: 8px; color: rgba(255,255,255,0.7); font-size: 0.9rem;">Section Title</label>
                            <input type="text" class="table-search" style="width: 100%;" value="New Section" data-field="title">
                        </div>
                        <div></div>
                    </div>
                    <button class="btn btn-danger" onclick="removeSection(this.parentElement.parentElement)" style="margin-left: 16px;">
                        <i class="fas fa-trash"></i> Remove Section
                    </button>
                </div>
                
                <div class="links-container">
                    <button class="btn btn-success" onclick="addLink(this.parentElement)" style="width: 100%; margin-top: 12px;">
                        <i class="fas fa-plus"></i> Add Link
                    </button>
                </div>
            `;
            
            // Insert before the "Add Section" button
            const addButton = container.querySelector('.btn-primary');
            container.insertBefore(newSection, addButton);
        }

        // Remove section
        function removeSection(indexOrElement) {
            if (typeof indexOrElement === 'number') {
                const sections = document.querySelectorAll('#linkSectionsContainer .section-item');
                if (sections[indexOrElement]) {
                    sections[indexOrElement].remove();
                }
            } else {
                indexOrElement.remove();
            }
        }

        // Add link
        function addLink(sectionIndexOrElement) {
            if (typeof sectionIndexOrElement === 'number') {
                // Add to specific section by index
                const sections = document.querySelectorAll('#linkSectionsContainer .section-item');
                if (sections[sectionIndexOrElement]) {
                    const linksContainer = sections[sectionIndexOrElement].querySelector('.links-container');
                    const addButton = linksContainer.querySelector('.btn-success');
                    const newLink = createLinkElement();
                    linksContainer.insertBefore(newLink, addButton);
                }
            } else {
                // Add to section element
                const linksContainer = sectionIndexOrElement;
                const addButton = linksContainer.querySelector('.btn-success');
                const newLink = createLinkElement();
                linksContainer.insertBefore(newLink, addButton);
            }
        }

        // Create link element
        function createLinkElement() {
            const linkEl = document.createElement('div');
            linkEl.className = 'link-item';
            linkEl.style.cssText = 'margin-bottom: 16px; padding: 16px; background: rgba(255,255,255,0.03); border-radius: 8px;';
            linkEl.innerHTML = `
                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 12px; align-items: end; margin-bottom: 12px;">
                    <div>
                        <label style="display: block; margin-bottom: 4px; color: rgba(255,255,255,0.6); font-size: 0.8rem;">Title</label>
                        <input type="text" class="table-search" style="width: 100%;" value="" data-field="title">
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 4px; color: rgba(255,255,255,0.6); font-size: 0.8rem;">Subtitle</label>
                        <input type="text" class="table-search" style="width: 100%;" value="" data-field="subtitle">
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 4px; color: rgba(255,255,255,0.6); font-size: 0.8rem;">URL</label>
                        <input type="text" class="table-search" style="width: 100%;" value="" data-field="url">
                    </div>
                    <button class="btn btn-danger" onclick="removeLink(this.parentElement.parentElement)" style="padding: 8px 12px;">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; align-items: end;">
                    <div>
                        <label style="display: block; margin-bottom: 4px; color: rgba(255,255,255,0.6); font-size: 0.8rem;">Icon</label>
                        <input type="text" class="table-search" style="width: 100%;" value="" data-field="icon">
                    </div>
                    <div>
                        <label style="display: block; margin-bottom: 4px; color: rgba(255,255,255,0.6); font-size: 0.8rem;">Color</label>
                        <input type="text" class="table-search" style="width: 100%;" value="#667eea" data-field="color">
                    </div>
                </div>
            `;
            return linkEl;
        }

        // Remove link
        function removeLink(sectionIndex, linkIndexOrElement) {
            if (typeof linkIndexOrElement === 'number') {
                // Remove by indices
                const sections = document.querySelectorAll('#linkSectionsContainer .section-item');
                if (sections[sectionIndex]) {
                    const links = sections[sectionIndex].querySelectorAll('.link-item');
                    if (links[linkIndexOrElement]) {
                        links[linkIndexOrElement].remove();
                    }
                }
            } else {
                // Remove by element
                linkIndexOrElement.remove();
            }
        }

        // Toast notification
        function showToast(message, isError = false) {
            const toast = document.getElementById('toast');
            toast.textContent = message;
            toast.className = 'toast' + (isError ? ' error' : '');
            toast.classList.add('show');
            
            setTimeout(() => toast.classList.remove('show'), 3000);
        }

        // Logout
        function logout() {
            window.location.href = '/';
        }

        // Initial load
        loadBanned();
        loadSocialMedia();
        loadLinkSections();
    </script>
</body>
</html>
