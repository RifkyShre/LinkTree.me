<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - <%= config.title %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #0f1117;
            color: #fff;
            min-height: 100vh;
        }

        .admin-container {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar */
        .sidebar {
            width: 260px;
            background: #161922;
            padding: 24px;
            border-right: 1px solid rgba(255,255,255,0.1);
        }

        .sidebar-title {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 32px;
            color: #667eea;
        }

        .nav-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 16px;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-bottom: 8px;
            color: rgba(255,255,255,0.7);
        }

        .nav-item:hover, .nav-item.active {
            background: rgba(102, 126, 234, 0.15);
            color: #667eea;
        }

        .nav-item i {
            width: 20px;
        }

        /* Main Content */
        .main-content {
            flex: 1;
            padding: 32px;
            overflow-y: auto;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 32px;
        }

        .header h1 {
            font-size: 2rem;
            font-weight: 700;
        }

        .header-actions {
            display: flex;
            gap: 12px;
        }

        .btn {
            padding: 12px 24px;
            border: none;
            border-radius: 12px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .btn-danger {
            background: rgba(244, 67, 54, 0.2);
            color: #f44336;
            border: 1px solid rgba(244, 67, 54, 0.3);
        }

        .btn-danger:hover {
            background: rgba(244, 67, 54, 0.3);
        }

        .btn-success {
            background: rgba(76, 175, 80, 0.2);
            color: #4caf50;
            border: 1px solid rgba(76, 175, 80, 0.3);
        }

        .btn-success:hover {
            background: rgba(76, 175, 80, 0.3);
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            margin-bottom: 32px;
        }

        .stat-card {
            background: rgba(255,255,255,0.05);
            border-radius: 20px;
            padding: 24px;
            border: 1px solid rgba(255,255,255,0.1);
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            margin-bottom: 16px;
        }

        .stat-icon.blue { background: rgba(102, 126, 234, 0.2); color: #667eea; }
        .stat-icon.green { background: rgba(76, 175, 80, 0.2); color: #4caf50; }
        .stat-icon.orange { background: rgba(255, 152, 0, 0.2); color: #ff9800; }
        .stat-icon.red { background: rgba(244, 67, 54, 0.2); color: #f44336; }

        .stat-value {
            font-size: 2rem;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .stat-label {
            color: rgba(255,255,255,0.6);
            font-size: 0.9rem;
        }

        /* Tables */
        .table-container {
            background: rgba(255,255,255,0.05);
            border-radius: 20px;
            border: 1px solid rgba(255,255,255,0.1);
            overflow: hidden;
        }

        .table-header {
            padding: 20px 24px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .table-title {
            font-size: 1.2rem;
            font-weight: 600;
        }

        .table-search {
            padding: 10px 16px;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 10px;
            color: #fff;
            width: 250px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 16px 24px;
            text-align: left;
        }

        th {
            background: rgba(255,255,255,0.03);
            font-weight: 600;
            color: rgba(255,255,255,0.6);
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        td {
            border-top: 1px solid rgba(255,255,255,0.05);
        }

        tr:hover td {
            background: rgba(255,255,255,0.03);
        }

        .ip-address {
            font-family: monospace;
            background: rgba(102, 126, 234, 0.15);
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 0.85rem;
        }

        .badge {
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .badge.success {
            background: rgba(76, 175, 80, 0.2);
            color: #4caf50;
        }

        .badge.danger {
            background: rgba(244, 67, 54, 0.2);
            color: #f44336;
        }

        .badge.warning {
            background: rgba(255, 152, 0, 0.2);
            color: #ff9800;
        }

        .action-btn {
            padding: 8px 16px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.85rem;
            transition: all 0.3s ease;
            margin-right: 8px;
        }

        .action-btn.ban {
            background: rgba(244, 67, 54, 0.2);
            color: #f44336;
        }

        .action-btn.ban:hover {
            background: rgba(244, 67, 54, 0.3);
        }

        .action-btn.unban {
            background: rgba(76, 175, 80, 0.2);
            color: #4caf50;
        }

        .action-btn.unban:hover {
            background: rgba(76, 175, 80, 0.3);
        }

        /* Tabs */
        .tabs {
            display: flex;
            gap: 8px;
            margin-bottom: 24px;
        }

        .tab {
            padding: 12px 24px;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            color: rgba(255,255,255,0.7);
        }

        .tab:hover, .tab.active {
            background: rgba(102, 126, 234, 0.2);
            border-color: #667eea;
            color: #667eea;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        /* Loading */
        .loading {
            text-align: center;
            padding: 40px;
            color: rgba(255,255,255,0.5);
        }

        .loading i {
            font-size: 2rem;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        /* Toast */
        .toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            padding: 16px 24px;
            background: rgba(76, 175, 80, 0.2);
            border: 1px solid rgba(76, 175, 80, 0.3);
            border-radius: 12px;
            color: #4caf50;
            font-weight: 500;
            transform: translateY(100px);
            opacity: 0;
            transition: all 0.3s ease;
        }

        .toast.show {
            transform: translateY(0);
            opacity: 1;
        }

        .toast.error {
            background: rgba(244, 67, 54, 0.2);
            border-color: rgba(244, 67, 54, 0.3);
            color: #f44336;
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: rgba(255,255,255,0.7);
            font-size: 0.9rem;
        }

        .form-input {
            width: 100%;
            padding: 12px 16px;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 10px;
            color: #fff;
            font-size: 0.9rem;
        }

        .form-input:focus {
            outline: none;
            border-color: #667eea;
        }

        .form-row {
            display: flex;
            gap: 12px;
            margin-bottom: 16px;
        }

        .form-row .form-group {
            flex: 1;
        }

        .social-media-item, .link-item {
            background: rgba(255,255,255,0.05);
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 16px;
            border: 1px solid rgba(255,255,255,0.1);
        }

        .social-media-item .form-row, .link-item .form-row {
            margin-bottom: 0;
        }

        .item-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
        }

        .item-title {
            font-size: 1rem;
            font-weight: 600;
        }

        .remove-btn {
            background: rgba(244, 67, 54, 0.2);
            color: #f44336;
            border: 1px solid rgba(244, 67, 54, 0.3);
            padding: 6px 12px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.8rem;
            transition: all 0.3s ease;
        }

        .remove-btn:hover {
            background: rgba(244, 67, 54, 0.3);
        }

        .add-link-btn {
            background: rgba(102, 126, 234, 0.2);
            color: #667eea;
            border: 1px solid rgba(102, 126, 234, 0.3);
            padding: 6px 12px;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.8rem;
            margin-left: 8px;
            transition: all 0.3s ease;
        }

        .add-link-btn:hover {
            background: rgba(102, 126, 234, 0.3);
        }
    </style>
</head>
<body>
    <div class="admin-container">
        <!-- Sidebar -->
        <div class="sidebar">
            <div class="sidebar-title">
                <i class="fas fa-shield-alt"></i> Admin Panel
            </div>
            <div class="nav-item active" onclick="showTab('dashboard')">
                <i class="fas fa-chart-line"></i>
                <span>Dashboard</span>
            </div>
            <div class="nav-item" onclick="showTab('content')">
                <i class="fas fa-edit"></i>
                <span>Content</span>
            </div>
            <div class="nav-item" onclick="showTab('banned')">
                <i class="fas fa-ban"></i>
                <span>Banned IPs</span>
            </div>
            <div class="nav-item" onclick="showTab('settings')">
                <i class="fas fa-cog"></i>
                <span>Settings</span>
            </div>
            <div class="nav-item" onclick="logout()">
                <i class="fas fa-sign-out-alt"></i>
                <span>Logout</span>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-content">
            <!-- Dashboard Tab -->
            <div id="dashboard" class="tab-content active">
                <div class="header">
                    <h1>Dashboard</h1>
                    <div class="header-actions">
                        <button class="btn btn-danger" onclick="clearVisitors()">
                            <i class="fas fa-trash"></i> Clear Data
                        </button>
                    </div>
                </div>

                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon blue">
                            <i class="fas fa-users"></i>
                        </div>
                        <div class="stat-value" id="totalVisitors">-</div>
                        <div class="stat-label">Total Visitors</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon green">
                            <i class="fas fa-calendar-day"></i>
                        </div>
                        <div class="stat-value" id="todayVisitors">-</div>
                        <div class="stat-label">Today Visitors</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon orange">
                            <i class="fas fa-clock"></i>
                        </div>
                        <div class="stat-value" id="activeNow">-</div>
                        <div class="stat-label">Active Now</div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon red">
                            <i class="fas fa-ban"></i>
                        </div>
                        <div class="stat-value" id="bannedCount">-</div>
                        <div class="stat-label">Banned IPs</div>
                    </div>
                </div>

                <div class="stat-card" style="margin-bottom: 24px;">
                    <div class="stat-icon blue">
                        <i class="fas fa-server"></i>
                    </div>
                    <div class="stat-value" id="uptime">-</div>
                    <div class="stat-label">Server Uptime</div>
                </div>
            </div>

            <!-- Content Tab -->
            <div id="content" class="tab-content">
                <div class="header">
                    <h1>Content Editor</h1>
                </div>

                <div class="tabs">
                    <div class="tab active" onclick="showContentTab('social-media')">Social Media</div>
                    <div class="tab" onclick="showContentTab('links')">Links</div>
                </div>

                <!-- Social Media Editor -->
                <div id="social-media" class="tab-content active">
                    <div class="table-container" style="padding: 24px;">
                        <h3 style="margin-bottom: 16px;">Social Media Links</h3>
                        <div id="socialMediaContainer">
                            <div class="loading">
                                <i class="fas fa-spinner"></i><br>Loading...
                            </div>
                        </div>
                        <button class="btn btn-primary" onclick="addSocialMedia()" style="margin-top: 16px;">
                            <i class="fas fa-plus"></i> Add Social Media
                        </button>
                        <button class="btn btn-success" onclick="saveSocialMedia()" style="margin-top: 16px; margin-left: 8px;">
                            <i class="fas fa-save"></i> Save Changes
                        </button>
                        <div id="socialMediaStatus" style="margin-top: 12px; font-size: 0.9rem;"></div>
                    </div>
                </div>

                <!-- Links Editor -->
                <div id="links" class="tab-content">
                    <div class="table-container" style="padding: 24px;">
                        <h3 style="margin-bottom: 16px;">Link Sections</h3>
                        <div id="linkSectionsContainer">
                            <div class="loading">
                                <i class="fas fa-spinner"></i><br>Loading...
                            </div>
                        </div>
                        <button class="btn btn-primary" onclick="addLinkSection()" style="margin-top: 16px;">
                            <i class="fas fa-plus"></i> Add Section
                        </button>
                        <button class="btn btn-success" onclick="saveLinkSections()" style="margin-top: 16px; margin-left: 8px;">
                            <i class="fas fa-save"></i> Save Changes
                        </button>
                        <div id="linkSectionsStatus" style="margin-top: 12px; font-size: 0.9rem;"></div>
                    </div>
                </div>
            </div>

            <!-- Banned Tab -->
            <div id="banned" class="tab-content">
                <div class="header">
                    <h1>Banned IPs</h1>
                </div>

                <div class="table-container">
                    <div class="table-header">
                        <div class="table-title">Blocked IPs</div>
                    </div>
                    <table>
                        <thead>
                            <tr>
                                <th>IP Address</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="bannedTable">
                            <tr>
                                <td colspan="3" class="loading">
                                    <i class="fas fa-spinner"></i><br>Loading...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Settings Tab -->
            <div id="settings" class="tab-content">
                <div class="header">
                    <h1>Settings</h1>
                </div>

                <div class="table-container" style="padding: 24px;">
                    <h3 style="margin-bottom: 16px;">Rate Limiting Configuration</h3>
                    <div style="display: grid; gap: 16px; max-width: 400px;">
                        <div>
                            <label style="display: block; margin-bottom: 8px; color: rgba(255,255,255,0.7);">Max Requests per Second</label>
                            <input type="number" class="table-search" style="width: 100%;" id="maxRequestsPerSecond" min="1" max="100">
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 8px; color: rgba(255,255,255,0.7);">Block Duration (seconds)</label>
                            <input type="number" class="table-search" style="width: 100%;" id="blockDuration" min="10" max="3600">
                        </div>
                        <div>
                            <label style="display: block; margin-bottom: 8px; color: rgba(255,255,255,0.7);">Window Size (milliseconds)</label>
                            <input type="number" class="table-search" style="width: 100%;" id="windowSize" min="500" max="10000">
                        </div>
                        <button class="btn btn-primary" onclick="updateSettings()">
                            <i class="fas fa-save"></i> Save Settings
                        </button>
                        <div id="settingsStatus" style="margin-top: 12px; font-size: 0.9rem;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Notification -->
    <div class="toast" id="toast"></div>

    <script>
        // Tab switching
        function showTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
            document.querySelectorAll('.nav-item').forEach(item => item.classList.remove('active'));
            
            document.getElementById(tabId).classList.add('active');
            event.currentTarget.classList.add('active');
        }

        // Load stats
        async function loadStats() {
            try {
                const response = await fetch('/admin/stats');
                const data = await response.json();
                
                document.getElementById('totalVisitors').textContent = data.totalVisitors;
                document.getElementById('todayVisitors').textContent = data.todayVisitors;
                document.getElementById('activeNow').textContent = data.hourVisitors;
                document.getElementById('bannedCount').textContent = data.bannedCount;
                
                // Format uptime
                const uptime = Math.floor(data.uptime);
                const hours = Math.floor(uptime / 3600);
                const minutes = Math.floor((uptime % 3600) / 60);
                document.getElementById('uptime').textContent = `${hours}h ${minutes}m`;
            } catch (error) {
                showToast('Failed to load stats', true);
            }
        }

        // Show content tabs
        function showContentTab(tabId) {
            document.querySelectorAll('#content .tab-content').forEach(tab => tab.classList.remove('active'));
            document.querySelectorAll('#content .tab').forEach(tab => tab.classList.remove('active'));
            
            document.getElementById(tabId).classList.add('active');
            event.currentTarget.classList.add('active');
        }

        // Load social media
        async function loadSocialMedia() {
            try {
                const response = await fetch('/admin/social-media');
                const socialMedia = await response.json();
                renderSocialMedia(socialMedia);
            } catch (error) {
                document.getElementById('socialMediaContainer').innerHTML = '<div style="color: #f44336;">Failed to load social media</div>';
            }
        }

        // Render social media items
        function renderSocialMedia(socialMedia) {
            const container = document.getElementById('socialMediaContainer');
            if (socialMedia.length === 0) {
                container.innerHTML = '<div style="text-align: center; color: rgba(255,255,255,0.5);">No social media links</div>';
                return;
            }

            container.innerHTML = socialMedia.map((item, index) => `
                <div class="social-media-item">
                    <div class="item-header">
                        <div class="item-title">Social Media ${index + 1}</div>
                        <button class="remove-btn" onclick="removeSocialMedia(${index})">
                            <i class="fas fa-trash"></i> Remove
                        </button>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>Name</label>
                            <input type="text" class="form-input" value="${item.name}" data-field="name" data-index="${index}">
                        </div>
                        <div class="form-group">
                            <label>Icon Class</label>
                            <input type="text" class="form-input" value="${item.icon}" data-field="icon" data-index="${index}">
                        </div>
                    </div>
                    <div class="form-group">
                        <label>URL</label>
                        <input type="url" class="form-input" value="${item.url}" data-field="url" data-index="${index}">
                    </div>
                </div>
            `).join('');
        }

        // Add social media item
        function addSocialMedia() {
            const container = document.getElementById('socialMediaContainer');
            const index = container.querySelectorAll('.social-media-item').length;
            
            const newItem = document.createElement('div');
            newItem.className = 'social-media-item';
            newItem.innerHTML = `
                <div class="item-header">
                    <div class="item-title">Social Media ${index + 1}</div>
                    <button class="remove-btn" onclick="removeSocialMedia(${index})">
                        <i class="fas fa-trash"></i> Remove
                    </button>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Name</label>
                        <input type="text" class="form-input" value="" data-field="name" data-index="${index}" placeholder="e.g. Instagram">
                    </div>
                    <div class="form-group">
                        <label>Icon Class</label>
                        <input type="text" class="form-input" value="" data-field="icon" data-index="${index}" placeholder="e.g. fab fa-instagram">
                    </div>
                </div>
                <div class="form-group">
                    <label>URL</label>
                    <input type="url" class="form-input" value="" data-field="url" data-index="${index}" placeholder="https://...">
                </div>
            `;
            container.appendChild(newItem);
        }

        // Remove social media item
        function removeSocialMedia(index) {
            if (!confirm('Remove this social media link?')) return;
            
            const items = document.querySelectorAll('.social-media-item');
            if (items[index]) {
                items[index].remove();
                // Re-index remaining items
                document.querySelectorAll('.social-media-item').forEach((item, newIndex) => {
                    item.querySelector('.item-title').textContent = `Social Media ${newIndex + 1}`;
                    item.querySelectorAll('input').forEach(input => {
                        input.setAttribute('data-index', newIndex);
                    });
                    const removeBtn = item.querySelector('.remove-btn');
                    removeBtn.setAttribute('onclick', `removeSocialMedia(${newIndex})`);
                });
            }
        }

        // Save social media
        async function saveSocialMedia() {
            const items = document.querySelectorAll('.social-media-item');
            const socialMedia = [];
            
            items.forEach(item => {
                const inputs = item.querySelectorAll('input');
                const data = {};
                inputs.forEach(input => {
                    data[input.getAttribute('data-field')] = input.value;
                });
                
                if (data.name && data.icon && data.url) {
                    socialMedia.push(data);
                }
            });
            
            const statusDiv = document.getElementById('socialMediaStatus');
            
            try {
                const response = await fetch('/admin/social-media', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ socialMedia })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    statusDiv.textContent = 'Social media updated successfully!';
                    statusDiv.style.color = '#4caf50';
                    showToast('Social media links updated');
                    loadSocialMedia();
                } else {
                    statusDiv.textContent = result.error || 'Failed to update social media';
                    statusDiv.style.color = '#f44336';
                }
            } catch (error) {
                statusDiv.textContent = 'Error updating social media';
                statusDiv.style.color = '#f44336';
                showToast('Failed to update social media', true);
            }
        }

        // Load link sections
        async function loadLinkSections() {
            try {
                const response = await fetch('/admin/link-sections');
                const linkSections = await response.json();
                renderLinkSections(linkSections);
            } catch (error) {
                document.getElementById('linkSectionsContainer').innerHTML = '<div style="color: #f44336;">Failed to load link sections</div>';
            }
        }

        // Render link sections
        function renderLinkSections(linkSections) {
            const container = document.getElementById('linkSectionsContainer');
            if (linkSections.length === 0) {
                container.innerHTML = '<div style="text-align: center; color: rgba(255,255,255,0.5);">No link sections</div>';
                return;
            }

            container.innerHTML = linkSections.map((section, sectionIndex) => `
                <div class="link-section-item" style="background: rgba(255,255,255,0.05); border-radius: 12px; padding: 16px; margin-bottom: 24px; border: 1px solid rgba(255,255,255,0.1);">
                    <div class="item-header">
                        <div class="item-title">Section ${sectionIndex + 1}</div>
                        <button class="remove-btn" onclick="removeLinkSection(${sectionIndex})">
                            <i class="fas fa-trash"></i> Remove Section
                        </button>
                    </div>
                    <div class="form-group">
                        <label>Section Title</label>
                        <input type="text" class="form-input" value="${section.title}" data-field="title" data-section="${sectionIndex}">
                    </div>
                    <div class="links-container" data-section="${sectionIndex}">
                        ${section.links.map((link, linkIndex) => `
                            <div class="link-item">
                                <div class="item-header">
                                    <div class="item-title">Link ${linkIndex + 1}</div>
                                    <button class="remove-btn" onclick="removeLink(${sectionIndex}, ${linkIndex})">
                                        <i class="fas fa-trash"></i> Remove
                                    </button>
                                </div>
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Title</label>
                                        <input type="text" class="form-input" value="${link.title}" data-field="title" data-section="${sectionIndex}" data-link="${linkIndex}">
                                    </div>
                                    <div class="form-group">
                                        <label>URL</label>
                                        <input type="url" class="form-input" value="${link.url}" data-field="url" data-section="${sectionIndex}" data-link="${linkIndex}">
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label>Subtitle (optional)</label>
                                    <input type="text" class="form-input" value="${link.subtitle || ''}" data-field="subtitle" data-section="${sectionIndex}" data-link="${linkIndex}">
                                </div>
                            </div>
                        `).join('')}
                    </div>
                    <button class="add-link-btn" onclick="addLink(${sectionIndex})">
                        <i class="fas fa-plus"></i> Add Link
                    </button>
                </div>
            `).join('');
        }

        // Add link section
        function addLinkSection() {
            const container = document.getElementById('linkSectionsContainer');
            const sectionIndex = container.querySelectorAll('.link-section-item').length;
            
            const newSection = document.createElement('div');
            newSection.className = 'link-section-item';
            newSection.style.cssText = 'background: rgba(255,255,255,0.05); border-radius: 12px; padding: 16px; margin-bottom: 24px; border: 1px solid rgba(255,255,255,0.1);';
            newSection.innerHTML = `
                <div class="item-header">
                    <div class="item-title">Section ${sectionIndex + 1}</div>
                    <button class="remove-btn" onclick="removeLinkSection(${sectionIndex})">
                        <i class="fas fa-trash"></i> Remove Section
                    </button>
                </div>
                <div class="form-group">
                    <label>Section Title</label>
                    <input type="text" class="form-input" value="" data-field="title" data-section="${sectionIndex}" placeholder="e.g. Social Media">
                </div>
                <div class="links-container" data-section="${sectionIndex}">
                    <div class="link-item">
                        <div class="item-header">
                            <div class="item-title">Link 1</div>
                            <button class="remove-btn" onclick="removeLink(${sectionIndex}, 0)">
                                <i class="fas fa-trash"></i> Remove
                            </button>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Title</label>
                                <input type="text" class="form-input" value="" data-field="title" data-section="${sectionIndex}" data-link="0" placeholder="Link title">
                            </div>
                            <div class="form-group">
                                <label>URL</label>
                                <input type="url" class="form-input" value="" data-field="url" data-section="${sectionIndex}" data-link="0" placeholder="https://...">
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Subtitle (optional)</label>
                            <input type="text" class="form-input" value="" data-field="subtitle" data-section="${sectionIndex}" data-link="0" placeholder="Optional subtitle">
                        </div>
                    </div>
                </div>
                <button class="add-link-btn" onclick="addLink(${sectionIndex})">
                    <i class="fas fa-plus"></i> Add Link
                </button>
            `;
            container.appendChild(newSection);
        }

        // Remove link section
        function removeLinkSection(sectionIndex) {
            if (!confirm('Remove this entire section?')) return;
            
            const sections = document.querySelectorAll('.link-section-item');
            if (sections[sectionIndex]) {
                sections[sectionIndex].remove();
                // Re-index remaining sections
                document.querySelectorAll('.link-section-item').forEach((section, newIndex) => {
                    section.querySelector('.item-title').textContent = `Section ${newIndex + 1}`;
                    section.querySelectorAll('input, .links-container, .add-link-btn').forEach(el => {
                        const sectionAttr = el.getAttribute('data-section');
                        if (sectionAttr !== null) {
                            el.setAttribute('data-section', newIndex);
                        }
                    });
                    const removeBtn = section.querySelector('.remove-btn');
                    if (removeBtn && removeBtn.getAttribute('onclick').includes('removeLinkSection')) {
                        removeBtn.setAttribute('onclick', `removeLinkSection(${newIndex})`);
                    }
                });
            }
        }

        // Add link to section
        function addLink(sectionIndex) {
            const section = document.querySelector(`.links-container[data-section="${sectionIndex}"]`);
            const linkIndex = section.querySelectorAll('.link-item').length;
            
            const newLink = document.createElement('div');
            newLink.className = 'link-item';
            newLink.innerHTML = `
                <div class="item-header">
                    <div class="item-title">Link ${linkIndex + 1}</div>
                    <button class="remove-btn" onclick="removeLink(${sectionIndex}, ${linkIndex})">
                        <i class="fas fa-trash"></i> Remove
                    </button>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Title</label>
                        <input type="text" class="form-input" value="" data-field="title" data-section="${sectionIndex}" data-link="${linkIndex}" placeholder="Link title">
                    </div>
                    <div class="form-group">
                        <label>URL</label>
                        <input type="url" class="form-input" value="" data-field="url" data-section="${sectionIndex}" data-link="${linkIndex}" placeholder="https://...">
                    </div>
                </div>
                <div class="form-group">
                    <label>Subtitle (optional)</label>
                    <input type="text" class="form-input" value="" data-field="subtitle" data-section="${sectionIndex}" data-link="${linkIndex}" placeholder="Optional subtitle">
                </div>
            `;
            section.appendChild(newLink);
        }

        // Remove link
        function removeLink(sectionIndex, linkIndex) {
            if (!confirm('Remove this link?')) return;
            
            const section = document.querySelector(`.links-container[data-section="${sectionIndex}"]`);
            const links = section.querySelectorAll('.link-item');
            if (links[linkIndex]) {
                links[linkIndex].remove();
                // Re-index remaining links
                section.querySelectorAll('.link-item').forEach((link, newIndex) => {
                    link.querySelector('.item-title').textContent = `Link ${newIndex + 1}`;
                    link.querySelectorAll('input').forEach(input => {
                        input.setAttribute('data-link', newIndex);
                    });
                    const removeBtn = link.querySelector('.remove-btn');
                    removeBtn.setAttribute('onclick', `removeLink(${sectionIndex}, ${newIndex})`);
                });
            }
        }

        // Save link sections
        async function saveLinkSections() {
            const sections = document.querySelectorAll('.link-section-item');
            const linkSections = [];
            
            sections.forEach(section => {
                const titleInput = section.querySelector('input[data-field="title"]');
                const title = titleInput.value;
                
                const links = [];
                const linkItems = section.querySelectorAll('.link-item');
                linkItems.forEach(linkItem => {
                    const inputs = linkItem.querySelectorAll('input');
                    const linkData = {};
                    inputs.forEach(input => {
                        const field = input.getAttribute('data-field');
                        const value = input.value;
                        if (field && value) {
                            linkData[field] = value;
                        }
                    });
                    
                    if (linkData.title && linkData.url) {
                        links.push(linkData);
                    }
                });
                
                if (title && links.length > 0) {
                    linkSections.push({ title, links });
                }
            });
            
            const statusDiv = document.getElementById('linkSectionsStatus');
            
            try {
                const response = await fetch('/admin/link-sections', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ linkSections })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    statusDiv.textContent = 'Link sections updated successfully!';
                    statusDiv.style.color = '#4caf50';
                    showToast('Link sections updated');
                    loadLinkSections();
                } else {
                    statusDiv.textContent = result.error || 'Failed to update link sections';
                    statusDiv.style.color = '#f44336';
                }
            } catch (error) {
                statusDiv.textContent = 'Error updating link sections';
                statusDiv.style.color = '#f44336';
                showToast('Failed to update link sections', true);
            }
        }

        // Load banned
        async function loadBanned() {
            try {
                const response = await fetch('/admin/banned');
                const banned = await response.json();
                
                const tbody = document.getElementById('bannedTable');
                if (banned.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="3" style="text-align: center; color: rgba(255,255,255,0.5);">No banned IPs</td></tr>';
                    return;
                }
                
                tbody.innerHTML = banned.map(ip => `
                    <tr>
                        <td><span class="ip-address">${ip}</span></td>
                        <td><span class="badge danger">Blocked</span></td>
                        <td>
                            <button class="action-btn unban" onclick="unbanIP('${ip}')">
                                <i class="fas fa-check"></i> Unban
                            </button>
                        </td>
                    </tr>
                `).join('');
            } catch (error) {
                document.getElementById('bannedTable').innerHTML = '<tr><td colspan="3" style="text-align: center; color: #f44336;">Failed to load banned IPs</td></tr>';
            }
        }

        // Ban IP
        async function banIP(ip) {
            if (!confirm(`Ban IP ${ip}?`)) return;
            
            try {
                const response = await fetch(`/admin/ban?ip=${encodeURIComponent(ip)}`, {
                    method: 'POST'
                });
                const data = await response.json();
                
                if (data.success) {
                    showToast(data.message);
                    loadVisitors();
                    loadBanned();
                    loadStats();
                } else {
                    showToast(data.error || 'Failed to ban IP', true);
                }
            } catch (error) {
                showToast('Failed to ban IP', true);
            }
        }

        // Unban IP
        async function unbanIP(ip) {
            if (!confirm(`Unban IP ${ip}?`)) return;
            
            try {
                const response = await fetch(`/admin/unban?ip=${encodeURIComponent(ip)}`, {
                    method: 'POST'
                });
                const data = await response.json();
                
                if (data.success) {
                    showToast(data.message);
                    loadVisitors();
                    loadBanned();
                    loadStats();
                } else {
                    showToast(data.error || 'Failed to unban IP', true);
                }
            } catch (error) {
                showToast('Failed to unban IP', true);
            }
        }

        // Clear visitors
        async function clearVisitors() {
            if (!confirm('Clear all visitor data?')) return;
            
            try {
                const response = await fetch('/admin/clear-visitors');
                const data = await response.json();
                
                if (data.success) {
                    showToast(data.message);
                    loadVisitors();
                    loadStats();
                } else {
                    showToast('Failed to clear visitors', true);
                }
            } catch (error) {
                showToast('Failed to clear visitors', true);
            }
        }

        // Filter visitors
        function filterVisitors() {
            const search = document.getElementById('visitorSearch').value.toLowerCase();
            const rows = document.querySelectorAll('#visitorTable tr');
            
            rows.forEach(row => {
                const ip = row.querySelector('.ip-address')?.textContent.toLowerCase() || '';
                row.style.display = ip.includes(search) ? '' : 'none';
            });
        }

        // Toast notification
        function showToast(message, isError = false) {
            const toast = document.getElementById('toast');
            toast.textContent = message;
            toast.className = 'toast' + (isError ? ' error' : '');
            toast.classList.add('show');
            
            setTimeout(() => toast.classList.remove('show'), 3000);
        }

        // Logout
        function logout() {
            window.location.href = '/';
        }

        // Load settings
        async function loadSettings() {
            try {
                const response = await fetch('/admin/settings');
                const settings = await response.json();
                
                document.getElementById('maxRequestsPerSecond').value = settings.maxRequestsPerSecond;
                document.getElementById('blockDuration').value = settings.blockDuration / 1000; // Convert to seconds
                document.getElementById('windowSize').value = settings.windowSize;
            } catch (error) {
                console.error('Failed to load settings:', error);
            }
        }

        // Update settings
        async function updateSettings() {
            const maxRequestsPerSecond = parseInt(document.getElementById('maxRequestsPerSecond').value);
            const blockDuration = parseInt(document.getElementById('blockDuration').value) * 1000; // Convert to milliseconds
            const windowSize = parseInt(document.getElementById('windowSize').value);
            
            const statusDiv = document.getElementById('settingsStatus');
            
            if (isNaN(maxRequestsPerSecond) || maxRequestsPerSecond < 1 || maxRequestsPerSecond > 100) {
                statusDiv.textContent = 'Max requests must be between 1-100';
                statusDiv.style.color = '#f44336';
                return;
            }
            
            if (isNaN(blockDuration) || blockDuration < 10000 || blockDuration > 3600000) {
                statusDiv.textContent = 'Block duration must be between 10-3600 seconds';
                statusDiv.style.color = '#f44336';
                return;
            }
            
            if (isNaN(windowSize) || windowSize < 500 || windowSize > 10000) {
                statusDiv.textContent = 'Window size must be between 500-10000 milliseconds';
                statusDiv.style.color = '#f44336';
                return;
            }
            
            try {
                const response = await fetch('/admin/settings', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        maxRequestsPerSecond,
                        blockDuration,
                        windowSize
                    })
                });
                
                const result = await response.json();
                
                if (result.success) {
                    statusDiv.textContent = 'Settings updated successfully!';
                    statusDiv.style.color = '#4caf50';
                    showToast('Rate limiting settings updated');
                } else {
                    statusDiv.textContent = 'Failed to update settings';
                    statusDiv.style.color = '#f44336';
                }
            } catch (error) {
                statusDiv.textContent = 'Error updating settings';
                statusDiv.style.color = '#f44336';
                showToast('Failed to update settings', true);
            }
        }

        // Auto refresh every 30 seconds
        setInterval(() => {
            loadStats();
        }, 30000);

        // Initial load
        loadStats();
        loadSocialMedia();
        loadLinkSections();
        loadBanned();
        loadSettings();
    </script>
</body>
</html>
