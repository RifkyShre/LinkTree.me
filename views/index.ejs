<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= config.seo.title %></title>
    <meta name="description" content="<%= config.seo.description %>">
    <meta name="keywords" content="<%= config.seo.keywords %>">
    <meta property="og:title" content="<%= config.seo.title %>" />
    <meta property="og:description" content="<%= config.seo.description %>" />
    <meta name="theme-color" content="#ffff00">
    <meta name="msapplication-TileColor" content="#ffff00">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="manifest" href="/manifest.json">
    
    <!-- Favicon and icons -->
    
    <!-- Skip to main content link for accessibility -->
    <style>
        .skip-link {
            position: absolute;
            top: -40px;
            left: 6px;
            background: #007bff;
            color: white;
            padding: 8px;
            text-decoration: none;
            border-radius: 4px;
            z-index: 1000;
            font-weight: 600;
        }
        .skip-link:focus {
            top: 6px;
        }
    </style>
    
    <!-- Preload critical resources -->
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'">
    <link rel="preload" href="/css/style.css" as="style">
    <link rel="preload" href="<%= config.profile.avatar %>" as="image" fetchpriority="high">
    <% config.linkSections.forEach(section => { %>
    <% section.links.forEach(link => { %>
    <link rel="preload" href="/icons/<%= link.icon %>.svg" as="image">
    <% }); %>
    <% }); %>
    
    <!-- DNS prefetch for external domains -->
    <link rel="dns-prefetch" href="//fonts.googleapis.com">
    <link rel="dns-prefetch" href="//cdnjs.cloudflare.com">
    <link rel="dns-prefetch" href="//fonts.gstatic.com">
    
    <!-- Preconnect to improve connection speed -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
    
    <!-- Critical CSS inline - Neubrutalism Style -->
    <style>
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
        body{font-family:'Inter',system-ui,-apple-system,sans-serif;background:#000;color:#000;min-height:100vh;position:relative;overflow-x:hidden}
        .container{max-width:480px;margin:0 auto;padding:20px;position:relative;z-index:1}
        .avatar{width:120px;height:120px;border:4px solid #000;object-fit:cover;transform:rotate(-2deg);box-shadow:8px 8px 0 #000}
        .name{font-size:2.5rem;font-weight:900;margin:16px 0 8px;background:#fff;padding:8px 16px;border:4px solid #000;transform:rotate(1deg);display:inline-block}
        .bio{color:#000;background:#ff0;padding:12px 16px;border:4px solid #000;margin-bottom:24px;font-weight:700;transform:rotate(-1deg)}
        .social-icons{display:flex;gap:12px;justify-content:center;margin-bottom:32px}
        .social-icon{width:48px;height:48px;border:4px solid #000;display:flex;align-items:center;justify-content:center;text-decoration:none;background:#fff;transform:rotate(3deg);transition:transform 0.1s ease;box-shadow:4px 4px 0 #000}
        .social-icon:hover{transform:rotate(-3deg) scale(1.1);background:#ff0}
        .section-title{color:#000;background:#0ff;padding:8px 16px;border:4px solid #000;font-size:1rem;text-transform:uppercase;letter-spacing:2px;margin-bottom:16px;display:inline-block;font-weight:900;transform:rotate(-2deg)}
        .links-grid{display:flex;flex-direction:column;gap:16px;margin-bottom:32px}
        .link-card{display:flex;align-items:center;padding:20px;background:#fff;border:4px solid #000;text-decoration:none;color:#000;transform:rotate(1deg);transition:transform 0.1s ease;box-shadow:6px 6px 0 #000;position:relative}
        .link-card:hover{transform:rotate(-1deg) scale(1.02);background:#ff0}
        .link-card:nth-child(even){transform:rotate(-2deg)}
        .link-card:nth-child(even):hover{transform:rotate(2deg) scale(1.02)}
        .link-icon{font-size:2rem;margin-right:16px;width:40px;text-align:center;color:#000}
        .link-content{flex:1}
        .link-title{font-weight:900;font-size:1.1rem;margin-bottom:4px}
        .link-subtitle{font-size:0.9rem;font-weight:600;color:#000}
        .link-arrow{color:#000;font-size:1.2rem}
        .footer{text-align:center;margin-top:40px;padding-bottom:20px}
        .footer a{color:#000;background:#fff;padding:12px 20px;border:4px solid #000;text-decoration:none;font-weight:900;transform:rotate(-1deg);display:inline-block;transition:transform 0.1s ease;box-shadow:4px 4px 0 #000}
        .footer a:hover{transform:rotate(1deg);background:#ff0}
        /* Captcha overlay - neubrutalism style */
        .captcha-overlay{position:fixed;top:0;left:0;width:100%;height:100%;background:#000;border:8px solid #fff;z-index:1000;display:none}
        .captcha-overlay:not(.hidden){display:flex;align-items:center;justify-content:center}
        .captcha-container{background:#fff;border:6px solid #000;padding:30px;max-width:400px;width:90%;transform:rotate(-2deg);box-shadow:12px 12px 0 #000}
        .captcha-title{font-size:1.5rem;font-weight:900;color:#000;margin-bottom:16px;text-align:center}
        .captcha-instruction{font-weight:700;color:#000;margin-bottom:24px;text-align:center}
        .captcha-slider-track{background:#ff0;border:4px solid #000;height:60px;position:relative;margin-bottom:16px}
        .captcha-target-zone{background:#0f0;border:4px solid #000;width:60px;height:60px;position:absolute;right:10px;top:0}
        .captcha-ball{background:#f00;border:4px solid #000;width:50px;height:50px;border-radius:50%;position:absolute;top:5px;left:5px;cursor:grab}
        .captcha-status{font-weight:700;color:#000;text-align:center;margin-bottom:16px}
        .captcha-reset{background:#fff;border:4px solid #000;padding:12px 24px;font-weight:900;color:#000;cursor:pointer;transition:transform 0.1s ease;width:100%}
        .captcha-reset:hover{transform:scale(1.05);background:#ff0}
        /* Animated background elements */
        .bg-blob{position:fixed;border-radius:50%;opacity:0.1;z-index:0}
        .bg-blob-1{width:200px;height:200px;background:#ff0;top:10%;left:5%;animation:float 6s ease-in-out infinite}
        .bg-blob-2{width:150px;height:150px;background:#0f0;top:60%;right:10%;animation:float 8s ease-in-out infinite reverse}
        .bg-blob-3{width:100px;height:100px;background:#f00;bottom:20%;left:15%;animation:float 7s ease-in-out infinite}
        @keyframes float{0%,100%{transform:translateY(0) rotate(0deg)}50%{transform:translateY(-20px) rotate(5deg)}}
    </style>
    
    <!-- Async load non-critical CSS -->
    <link rel="stylesheet" href="/css/style.css" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" media="print" onload="this.media='all'">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" media="print" onload="this.media='all'">
    
    <noscript>
        <link rel="stylesheet" href="/css/style.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
    </noscript>
</head>
<body>
    <!-- Skip to main content link -->
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <!-- Captcha Overlay -->
    <div class="captcha-overlay hidden" id="captchaOverlay" role="dialog" aria-modal="true" aria-labelledby="captcha-title" aria-describedby="captcha-instruction">
        <div class="captcha-container">
            <h2 id="captcha-title" class="captcha-title">Slider Puzzle</h2>
            <p id="captcha-instruction" class="captcha-instruction">Geser bola ke dalam kotak hijau!</p>
            
            <div class="captcha-slider-track" id="captchaTrack" role="application" aria-label="Captcha slider puzzle">
                <div class="captcha-target-zone" id="captchaTarget" aria-label="Target zone"></div>
                <div class="captcha-ball" id="captchaBall" aria-label="Draggable ball" tabindex="0"></div>
            </div>
            
            <div class="captcha-status" id="captchaStatus" aria-live="polite" aria-atomic="true"></div>
            <button class="captcha-reset" id="captchaReset" aria-label="Reset captcha puzzle">Reset</button>
        </div>
    </div>

    <!-- Animated background blobs - decorative -->
    <div class="bg-blob bg-blob-1" aria-hidden="true"></div>
    <div class="bg-blob bg-blob-2" aria-hidden="true"></div>
    <div class="bg-blob bg-blob-3" aria-hidden="true"></div>
    
    <!-- Snow Effect Container - decorative -->
    <div id="snow-container" aria-hidden="true"></div>
    
    <div class="container">
        <!-- Main content -->
        <main id="main-content">
            <!-- Profile Header -->
            <header class="profile-header">
                <div class="avatar-wrapper">
                    <img src="<%= config.profile.avatar %>"
                         alt="<%= config.profile.name %> - Profile Avatar"
                         class="avatar"
                         width="120"
                         height="120"
                         loading="eager"
                         decoding="async"
                         fetchpriority="high"
                         onerror="this.src='/img/avatar-placeholder.png'">
                    <span class="status-indicator" aria-hidden="true"></span>
                </div>
                <div class="name-container">
                    <h1 class="name"><%= config.profile.name %></h1>
                    <% if (config.profile.verified) { %>
                    <span class="verified" aria-label="Verified account">
                        <i class="fas fa-check-circle" aria-hidden="true"></i>
                    </span>
                    <% } %>
                </div>
                <p class="bio"><%= config.profile.bio %></p>
                
                <!-- Social Media Icons -->
                <nav class="social-icons" aria-label="Social media links">
                    <% config.socialMedia.forEach(social => { %>
                    <a href="<%= social.url %>" 
                       class="social-icon" 
                       title="<%= social.name %>"
                       aria-label="Visit <%= social.name %> profile (opens in new tab)"
                       data-color="<%= social.color %>"
                       target="_blank"
                       rel="noopener noreferrer"
                       <% if (social.colorDark) { %>data-color-dark="<%= social.colorDark %>"<% } %>>
                        <i class="<%= social.icon %>" aria-hidden="true"></i>
                    </a>
                    <% }); %>
                </nav>
            </header>

            <!-- Link Sections -->
            <% config.linkSections.forEach(section => { %>
            <section class="section-divider" aria-labelledby="section-<%= section.title.toLowerCase().replace(/\s+/g, '-') %>">
                <h2 id="section-<%= section.title.toLowerCase().replace(/\s+/g, '-') %>" class="section-title"><%= section.title %></h2>
            </section>

            <div class="links-grid" role="list">
                <% section.links.forEach(link => { %>
                <a href="<%= link.url %>" 
                   class="link-card"
                   role="listitem"
                   aria-label="<%= link.title %> - <%= link.subtitle %> (opens in new tab)"
                   data-color="<%= link.color %>"
                   target="_blank"
                   rel="noopener noreferrer">
                    <i class="<%= link.icon %> link-icon" aria-hidden="true"></i>
                    <div class="link-content">
                        <div class="link-title"><%= link.title %></div>
                        <div class="link-subtitle"><%= link.subtitle %></div>
                    </div>
                    <i class="fas fa-arrow-right link-arrow" aria-hidden="true"></i>
                </a>
                <% }); %>
            </div>
            <% }); %>

            <!-- Spotify Section -->
            <% if (config.spotify.enabled) { %>
            <section class="section-divider" aria-labelledby="spotify-section">
                <h2 id="spotify-section" class="section-title"><%= config.spotify.title %></h2>
            </section>

            <div class="spotify-section">
                <div class="spotify-header">
                    <i class="fab fa-spotify spotify-icon" aria-hidden="true"></i>
                    <span class="spotify-title"><%= config.spotify.title %></span>
                </div>
                <iframe class="spotify-embed" 
                        src="<%= config.spotify.playlistUrl %>" 
                        title="Spotify playlist embed"
                        allowfullscreen 
                        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" 
                        loading="lazy"
                        width="100%"
                        height="152"
                        frameborder="0">
                </iframe>
            </div>
            <% } %>
        </main>

        <!-- Footer -->
        <footer class="footer">
            <a href="<%= config.footer.link %>" 
               aria-label="<%= config.footer.text %> (opens in new tab)"
               target="_blank"
               rel="noopener noreferrer"><%= config.footer.text %></a>
        </footer>
    </div>

    <!-- Load critical JS inline for better LCP -->
    <script>
        // Critical: Avatar preload and immediate rendering
        const avatar = document.querySelector('.avatar');
        if (avatar) {
            avatar.style.opacity = '1'; // Force immediate render
        }
    </script>

    <!-- Defer non-critical JavaScript -->
    <script src="/js/script.js" defer></script>
</body>
</html>
